# ── Apify / Immobiliare.it listings sync ────────────────────────────────────
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Demo tenant only: the original agency search page on Immobiliare.it.
# New tenants use the immobiliare_url they submit at signup.
IMMOBILIARE_SEARCH_URL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Signing secret (whsec_…) of the OpenAI project webhook. In the OpenAI
# dashboard (Settings → Webhooks) add an endpoint at {PUBLIC_BASE_URL}/call/incoming
# subscribed to the `realtime.call.incoming` event, then paste its secret here.
OPENAI_WEBHOOK_SECRET=

# ── Telephony (Twilio numbers → OpenAI SIP) ──────────────────────────────────
# Inbound calls arrive over SIP: in Twilio, create an Elastic SIP Trunk with an
# Origination URI of  sip:<OPENAI_PROJECT_ID>@sip.api.openai.com;transport=tls
# and attach each Apollonia number to that trunk. Calls then route to OpenAI,
# which fires the webhook above. Numbers are assigned manually per tenant — the
# app no longer sets a Twilio voice webhook.
# OPENAI_PROJECT_ID is only needed to build that SIP URI in the Twilio console;
# it's not read by the app. Find it in the OpenAI dashboard (Settings → General).
# TWILIO_ACCOUNT_SID / AUTH_TOKEN are used only by the dormant auto-provisioner.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Demo tenant's number (migrated into the tenants DB on first startup).
TWILIO_PHONE_NUMBER=
# Optional: second number for the Slovak-language demo tenant (locale='sk').
# When set, a "Štúdio Demo" tenant with Slovak seed listings + Slovak agent is
# created/bound to it at startup. Attach this number to the same SIP trunk.
TWILIO_PHONE_NUMBER_SK=

# ── Deployment ───────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000

# ── Multi-tenant ─────────────────────────────────────────────────────────────
# Bearer token protecting GET /admin/tenants
ADMIN_TOKEN=
# HMAC key that signs the agency dashboard session cookie. Any long random
# string (e.g. `openssl rand -hex 32`). If unset, falls back to ADMIN_TOKEN.
SESSION_SECRET=
# Where the SQLite tenants DB lives (Render persistent disk in production).
# For local dev on Windows, point this somewhere writable, e.g. ./data
DATA_DIR=/data

# ── Email (Resend HTTP API — Render blocks outbound SMTP) ────────────────────
# LEAD_EMAIL is the platform owner's address: it receives signup notifications
# and is the fallback recipient for demo-tenant lead summaries.
LEAD_EMAIL=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Signing secret of the Resend "email.received" webhook (Webhooks → your endpoint
# → Signing Secret, starts with whsec_). When set, POST /leads/inbound-email
# verifies the signature. Leave blank to accept unverified while testing.
RESEND_WEBHOOK_SECRET=
# For the reply test to work on the free Resend domain, send outreach FROM your
# <id>.resend.app address so replies route back into Resend, e.g.:
# OUTREACH_FROM_EMAIL=adam@xxxxxx.resend.app  (set in the lead-gen section above)

# ── Acquisizione (seller-meeting capture) ─────────────────────────────────────
# Ships dark until this is true — gates both the dashboard tab and the router.
ACQUISIZIONE_ENABLED=false
# Live streaming transcription model for the browser WebRTC meeting capture.
REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
# Its latency/accuracy tradeoff: minimal|low|medium|high|xhigh. Higher = more
# audio context before the model emits text = fewer transcription errors, at
# the cost of the live transcript trailing the speaker. Accuracy wins here.
REALTIME_TRANSCRIBE_DELAY=xhigh
# Property photo enhancement (declutter/relight/straighten).
IMAGE_EDIT_MODEL=gpt-image-2

# ── Text reasoning models ────────────────────────────────────────────────────
# Both default to the same model (GPT-5.6 Terra) and are meant to be bumped
# together; override just one only to pin a task to a different model.
# Post-call one-sentence summary at the top of the lead email.
SUMMARY_MODEL=gpt-5.6-terra
# Transcript → structured listing fields/notes.
EXTRACTION_MODEL=gpt-5.6-terra

# ── Stripe billing (Checkout) ────────────────────────────────────────────────
# Test keys for now (sk_test_… / whsec_…); swap to live keys before launch.
# STRIPE_SECRET_KEY: Developers → API keys (use a restricted key if possible).
# STRIPE_WEBHOOK_SECRET: signing secret of the POST /webhook endpoint you
# register in the Stripe Dashboard (Developers → Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Demo tenant listings cache (GitHub CSV) ──────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_CSV_PATH=backend/data/listings.csv
GITHUB_BRANCH=main

# ── Lead generation / cold outreach (ApollonIA agency prospecting) ───────────
# Google Places API key (Places API + Place Details enabled).
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=
# Sender address for outreach emails (must be a verified Resend domain).
# Falls back to RESEND_FROM when unset, e.g. adam@apollon-ia.com
OUTREACH_FROM_EMAIL=
# Reply-To for outreach: lead replies land here. Set to your real inbox so you
# can answer prospects directly (no DNS changes needed), e.g. info@apollon-ia.com
OUTREACH_REPLY_TO=
# Booking link surfaced in the dashboard / future templates.
CALENDLY_LINK=https://calendly.com/adam/demo

# ─────────────────────────────────────────────────────────────────────────────
# AI video tour (drone fly-in + interior room tour)
# ─────────────────────────────────────────────────────────────────────────────
# Ships dark until this is true — the router is not even mounted otherwise.
VIDEO_TOUR_ENABLED=false

# Google Maps Platform. THREE separate concerns, and the browser one must not
# be the same key as the other two:
#   - Geocoding API, server-side. Never sent to the browser.
GOOGLE_GEOCODING_API_KEY=
#   - Maps JavaScript API, embedded in the dashboard page for the draggable
#     marker. Anyone can read it off the page, so restrict it by HTTP referrer
#     and enable nothing on it but Maps JavaScript. Do NOT reuse
#     GOOGLE_PLACES_API_KEY or the geocoding key here.
GOOGLE_MAPS_BROWSER_KEY=
#   - Cloud-configured Map ID for the map above. Optional: without it the
#     wizard uses the legacy draggable Marker, which needs no Map ID.
#     Google's AdvancedMarkerElement requires one.
GOOGLE_MAPS_MAP_ID=
#   - Map Tiles API (Photorealistic 3D Tiles), read server-side by the headless
#     Cesium capture.
GOOGLE_MAP_TILES_API_KEY=

# Runway (https://dev.runwayml.com). Billed per second of generated output.
RUNWAY_API_KEY=
RUNWAY_API_VERSION=2024-11-06
# Seedance 2.5 is the model because it is the only family in Runway's API with
# multi-image REFERENCE mode, which is what lets one generation cover several
# rooms. gen4.5 and gen4_turbo accept a first frame only.
RUNWAY_VIDEO_MODEL=seedance2_5
# 854:480 | 1280:720 | 1920:1080 — 20 / 30 / 68 credits per second of output,
# at $0.01 a credit. The biggest cost lever on the whole feature.
RUNWAY_VIDEO_RATIO=1280:720

# Length of the drone fly-in, and roughly how long each room gets inside the
# single interior generation. Seedance accepts 4-30 seconds; the interior total
# is clamped to 30, which is what caps the cost of a tour with many rooms.
VIDEO_TOUR_DRONE_SECONDS=6
VIDEO_TOUR_SECONDS_PER_ROOM=4
# Seedance takes up to 30 reference images, so this is a cost cap rather than a
# model limit — every extra room is more generated (billed) seconds.
VIDEO_TOUR_MAX_INTERIOR_PHOTOS=8
# Each retry re-runs a paid generation, so a persistently failing job stops.
VIDEO_TOUR_MAX_ATTEMPTS=3

# Retention. Media shares the disk with receptionist.db, so a full disk is an
# outage rather than a degraded video feature.
VIDEO_TOUR_KEEP_READY_DAYS=30
VIDEO_TOUR_KEEP_DEAD_DAYS=2
VIDEO_TOUR_SWEEP_INTERVAL_SECONDS=21600
